datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("USER") // "USER" | "ADMIN"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  documents    Document[]
  pdfExports   PdfExport[]
  resetTokens  PasswordResetToken[]

  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model Document {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  templateId   String            @default("professional-business")
  settingsJson String            // JSON of DocumentSettings
  contentJson  String            // JSON of DocumentPage[]
  version      Int               @default(1)
  isFavorite   Boolean           @default(false)
  isTrash      Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  versions     DocumentVersion[]
  assets       DocumentAsset[]
  pdfExports   PdfExport[]

  @@index([userId])
  @@index([isTrash])
  @@index([isFavorite])
}

model DocumentVersion {
  id            String   @id @default(uuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int
  title         String
  settingsJson  String
  contentJson   String
  createdAt     DateTime @default(now())

  @@index([documentId])
}

model DocumentAsset {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int
  createdAt  DateTime @default(now())

  @@index([documentId])
}

model Template {
  id          String   @id
  name        String
  category    String
  description String
  thumbnail   String
  configJson  String   // JSON of TemplateDefinition
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model PdfExport {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileSize   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([documentId])
  @@index([userId])
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventType String   // "SIGNUP" | "LOGIN" | "DOC_CREATED" | "DOC_EXPORTED" | "TEMPLATE_USED"
  metadata  String?  // Optional JSON metadata
  createdAt DateTime @default(now())

  @@index([eventType])
}
