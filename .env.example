# Server & Database Configuration
PORT=4000
NODE_ENV=development

# Database (Default is SQLite for instant zero-config local run; switch to postgresql:// if preferred)
DATABASE_URL="file:./dev.db"

# JWT Secret
JWT_SECRET="docucraft-super-secure-production-secret-key-2026"
JWT_EXPIRES_IN="7d"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# Admin Defaults (Seeded)
ADMIN_EMAIL="admin@docucraft.io"
ADMIN_PASSWORD="AdminPassword123!"
